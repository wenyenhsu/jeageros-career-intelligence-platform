# Copy to .env.production and replace every value marked "replace".
SECRET_KEY=replace-with-a-random-value-of-at-least-50-characters
DEBUG=0
ALLOWED_HOSTS=jobs.example.com
CSRF_TRUSTED_ORIGINS=https://jobs.example.com

DB_NAME=jaegeros
DB_USER=jaegeros
DB_PASSWORD=replace-with-a-long-random-database-password
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60

REDIS_PASSWORD=replace-with-a-long-random-redis-password
CELERY_BROKER_URL=redis://:replace-with-a-long-random-redis-password@redis:6379/0
CELERY_RESULT_BACKEND=redis://:replace-with-a-long-random-redis-password@redis:6379/0

TLS_CERTIFICATE_PATH=./deploy/tls/fullchain.pem
TLS_PRIVATE_KEY_PATH=./deploy/tls/privkey.pem
HTTP_PORT=80
HTTPS_PORT=443

SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
# Use a dedicated hostname whose descendants are all permanently HTTPS-only.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

APPLICATION_MATERIALS_ROOT=/app/media/applications
RESUME_TEMPLATE_ROOT=/app/media/applications/resume_golden_template

# Ollama / crawl settings
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_SKILL_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
CRAWL_SCHEDULE_SECONDS=43200
CRAWL_SKILL_PIPELINE_ENABLED=true
SKILL_EMBEDDING_SCHEDULE_SECONDS=3600
SKILL_EMBEDDING_BATCH_LIMIT=100
SKILL_EMBEDDING_SYNC_ENABLED=true
SKILL_EMBEDDING_SYNC_AFTER_CRAWL=true
